<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Configuration — Xentz Backup</title>
<style>
html{color-scheme:dark}
body{background:#0c0e12;color:#e8eaef;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;margin:0;padding:36px 20px;max-width:960px;line-height:1.5}
h1{font-size:20px;margin-bottom:4px}
nav ul,.page-nav{display:flex;gap:8px;padding:0 0 18px;border-bottom:1px solid #252b38;margin-top:14px}
a.btn{text-decoration:none;padding:6px 13px;background:rgba(167,139,250,.15);color:#a78bfa;font-weight:500;border-radius:9px;font-size:14px}
.card{border:1px solid #252b38;border-radius:12px;padding:16px;background:#1a2029;box-shadow:0 1px 3px rgba(0,0,0,.4)}
.card h2{margin:0 0 12px;font-size:14px;text-transform:uppercase;letter-spacing:.6px;color:#8b93a7;font-weight:600}
.row{display:flex;gap:10px;align-items:center;margin:10px 0;padding:0}
label.config-label{min-width:200px;font-weight:500;color:#c3cad9}
input[type=text]{flex:1;padding:8px 12px;border:1px solid #252b38;border-radius:8px;font-size:14px;background:#1a2029;outline:none}
input[type=text]:focus{border-color:#3d9cf0;box-shadow:0 0 0 3px rgba(99,102,241,.15)}
input[readonly]{background:#10141b;color:#8b93a7;cursor:default}
.pill{display:inline-block;border-radius:999px;padding:3px 10px;font-size:12px;font-weight:600;border:1px solid #252b38;color:#8b93a7;margin-left:auto}
footer.notes{margin-top:28px;font-size:12px;color:#8b93a7;border-top:1px solid #252b38;padding-top:16px}
.hidden{display:none}
@media(max-width:700px){.row{flex-direction:column;gap:4px}}
</style>
</head>
<body>

<nav class="page-nav">
  <a class="btn" href="/">&larr; Dashboard</a>
</nav>

<h1>Configuration</h1>
<p style="color:#8b93a7;margin-bottom:16px">Current xentz-agent configuration. All values are read from the config file.</p>

<div class="card" style="margin-bottom:14px">
  <h2>Identity & Server</h2>
  <div class="row"><label class="config-label">Server URL:</label><input type="text" readonly value="{{.ServerURL}}"{{if not .ServerURL}} placeholder="Not configured"{{end}}></div>
  <div class="row"><label class="config-label">Tenant ID:</label><input type="text" readonly value="{{.TenantID}}"{{if not .TenantID}} placeholder="—"{{end}}></div>
  <div class="row"><label class="config-label">Device ID:</label><input type="text" readonly value="{{.DeviceID}}"{{if not .DeviceID}} placeholder="—"{{end}}></div>
  <div class="row"><label class="config-label">User ID:</label><input type="text" readonly value="{{.UserID}}"{{if not .UserID}} placeholder="—"{{end}}></div>
</div>

<div class="card" style="margin-bottom:14px">
  <h2>Schedule & State</h2>
  <div class="row"><label class="config-label">Config Revision:</label><input type="text" readonly value="{{.ConfigRev}}" placeholder="—"></div>
  <div class="row"><label class="config-label">Enabled:</label><span class="pill">{{if .EnableBool}}✓ Enabled{{else}}✗ Disabled (Kill Switch){{end}}</span></div>
</div>

<div class="card" style="margin-bottom:14px">
  <h2>Backup Paths</h2>
  <div class="row"><label class="config-label">Schedule:</label><input type="text" readonly value="{{.ScheduleCron}}"></div>
  <div class="row"><label class="config-label">Include:</label></div>
  {{range .IncludePaths}}<div class="row" style="padding-left:210px"><span style="color:#c3cad9">↳ {{.}}</span></div>
  {{end}}
  <div class="row"><label class="config-label">Exclude:</label></div>
  {{range .ExcludePaths}}<div class="row" style="padding-left:210px"><span style="color:#8b93a7">↳ {{.}}</span></div>
  {{end}}
  {{if not .IncludePaths}}<div class="row" style="padding-left:210px;color:#8b93a7;font-size:13px">(no include paths configured)</div>{{end}}
  {{if not .ExcludePaths}}<div class="row" style="padding-left:210px;color:#8b93a7;font-size:13px">(no exclude paths configured)</div>{{end}}
</div>

<div class="card" style="margin-bottom:14px">
  <h2>Restic & Retention</h2>
  <div class="row"><label class="config-label">Repository:</label><input type="text" readonly value="{{.ResticRepo}}"{{if not .ResticRepo}} placeholder="Not configured"{{end}}></div>
  <div class="row"><label class="config-label">Retention:</label><input type="text" readonly value="{{.Retention}}" placeholder="—"></div>
</div>

<div class="card" style="margin-bottom:14px">
  <h2>Secrets (redacted)</h2>
  <div class="row"><label class="config-label">API Key:</label><input type="text" readonly value="••••••••" placeholder="Redacted"></div>
  <div class="row"><label class="config-label">Install Token:</label><input type="text" readonly value="••••••••" placeholder="Redacted"></div>
  <div class="row"><label class="config-label">Password File:</label><input type="text" readonly value="{{.PasswordFile}}"{{if not .PasswordFile}} placeholder="Not configured"{{end}}></div>
</div>

<footer class="notes">Config page served by xentx-agent Local UI — read-only.</footer>
</body>
</html>
