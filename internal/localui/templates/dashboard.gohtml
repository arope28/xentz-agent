<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>xentz-agent — Backup Dashboard</title>
<style>
html{color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
:root{--bg:#0c0e12;--card:#141820;--text:#e8eaef;--muted:#8b93a7;--line:#252b38;--ok:#4ade80;--warn:#fbbf24;--err:#f87171;--blue:#3d9cf0;--blue-bg:#14263a}
body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;margin:0;padding:28px 20px;line-height:1.5;max-width:980px;margin-left:auto;margin-right:auto}
h1{font-size:22px;margin:0 0 6px;font-weight:700}
nav ul,.page-nav{display:flex;gap:8px;padding:0 0 20px;list-style:none;border-bottom:1px solid var(--line);margin-top:14px}
.page-nav a{text-decoration:none;color:var(--blue);padding:6px 13px;border-radius:8px;font-size:14px;font-weight:500;background:rgba(61,156,240,.12);border:1px solid rgba(61,156,240,.35);transition:background .15s}
.page-nav a:hover{background:rgba(61,156,240,.25)}.page-nav a.active{background:var(--blue);color:#fff;border-color:var(--blue)}
.grid4{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:13px;margin:18px 0}
.card{border-radius:12px;background:var(--card);border:1px solid var(--line);padding:16px;box-shadow:0 1px 2px rgba(0,0,0,.4)}
.card h3{margin:0 0 5px;font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);font-weight:600}
.val{font-size:18px;font-weight:700;line-height:1.4;margin-bottom:2px}
.hint{font-size:12px;color:var(--muted)}
.chip{display:inline-block;border-radius:999px;padding:3px 10px;font-size:12px;font-weight:600;border:1px solid var(--line);color:var(--muted)}
.chip.ok{background:rgba(74,222,128,.12);color:var(--ok);border-color:rgba(74,222,128,.35)}
.chip.warn{background:rgba(251,191,36,.12);color:var(--warn);border-color:rgba(251,191,36,.35)}
.chip.err{background:rgba(248,113,113,.12);color:var(--err);border-color:rgba(248,113,113,.35)}
.section-title{font-size:15px;font-weight:600;margin:24px 0 10px;display:flex;align-items:center;gap:8px;color:#c3cad9}
.section-title::before{content:'';width:3px;height:18px;background:var(--blue);border-radius:2px;display:inline-block}
.include-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.path-chip{background:#1a2029;border-radius:8px;padding:4px 10px;font-size:13px;font-family:monospace;color:#c3cad9}
.actions-row{display:flex;gap:8px;margin-top:8px;flex-wrap:wrap}
button,.btn-primary button,.btn-muted button{cursor:pointer;border-radius:9px;padding:7px 16px;font-size:13px;font-family:inherit}
.btn-primary button,.primary{background:var(--blue);color:#fff;border-color:var(--blue)}
.btn-primary button:hover,.primary:hover{background:#2a6fad}
button.btn-muted{background:#1a2029;color:#c3cad9;border:1px solid var(--line);border-radius:9px;padding:7px 16px;font-size:13px;cursor:pointer}
button.btn-muted:hover{border-color:rgba(61,156,240,.35);background:rgba(61,156,240,.12)}
footer.notes{margin-top:28px;font-size:12px;color:var(--muted)}#diag-toast{display:none;position:fixed;bottom:24px;right:24px;background:#252b38;color:#e8eaef;padding:12px 18px;border-radius:10px;font-size:13px;z-index:10}
@media(max-width:700px){.grid4{grid-template-columns:1fr 1fr}.page-nav a{padding:5px 10px;font-size:12px}}
</style>
</head>
<body>

<h1>xentz-agent Backup Dashboard</h1>
<nav class="page-nav"><a href="#dashboard">Dashboard</a><a href="/config?token={{.Token}}">Configuration</a><a href="/restore?token={{.Token}}">Restore Wizard</a></nav>

<div id="pg-dashboard">
  <div class="grid4">
    <div class="card"><h3>Status</h3><div class="val" id="st-badge"></div><p class="hint" id="st-detail"></p></div>
    <div class="card"><h3>Last Backup</h3><div class="val" id="last-bk-time">—</div><p class="hint" id="last-bk-detail"></p></div>
    <div class="card"><h3>Last Retention</h3><div class="val" id="last-ret-time">—</div><p class="hint" id="last-ret-detail"></p></div>
    <div class="card"><h3>Kill Switch</h3><div class="val" id="ks-badge"></div><p class="hint" id="ks-detail"></p></div>
  </div>

  <div id="config-summary-card" style="display:none">
    <h3>Backup Scope</h3>
    <div class="section-title">Include Paths</div>
    <div class="include-list" id="include-list"></div>
    <div class="section-title" style="margin-top:14px">Schedule &amp; Retention</div>
    <p class="hint" id="sched-detail"></p>
  </div>

  <div class="actions-row">
    <button class="btn-muted" type="button" onclick="makeDiag()">Create diagnostics bundle</button>
  </div>
</div>

<footer class="notes">Token stored at <code>{{.TokenPath}}</code><br>
This page is served by the xentz-agent local UI.</footer>
<div id="diag-toast"></div>

<script>
const T=`{{.Token}}`;
const qs=p=>p+(p.indexOf('?')>=0?'&':'?')+'token='+encodeURIComponent(T);
const badge=(id,k,h)=>{document.getElementById(id).innerHTML='<span class="chip'+(k?' '+k:'')+'">'+h+'</span>'};
const txt=(id,v)=>{document.getElementById(id).textContent=v};
// Accepts an RFC3339 string or an object with time_utc, so this keeps working
// whether the value came from /status?json=1 or a future richer payload.
function asTime(v){return !v?'':typeof v==='string'?v:(v.time_utc||'')}
function fmtTime(v){const s=asTime(v);if(!s)return 'Never';const d=new Date(s);return isNaN(d.getTime())?s:d.toLocaleString()}
function relTime(v){const s=asTime(v);if(!s)return '';const d=new Date(s);if(isNaN(d.getTime()))return '';
  const mins=Math.round((Date.now()-d.getTime())/60000);
  if(mins<1)return 'just now';
  if(mins<60)return mins+' min ago';
  const hrs=Math.round(mins/60);if(hrs<24)return hrs+' hour'+(hrs===1?'':'s')+' ago';
  const days=Math.round(hrs/24);return days+' day'+(days===1?'':'s')+' ago'}
async function jfetch(p){try{const r=await fetch(qs(p));return r.ok?await r.json():null}catch(e){return null}}
function plural(n,w){return n+' '+w+(n===1?'':'s')}

async function load(){
  const d=await jfetch('/status?json=1');
  if(!d){badge('st-badge','err','Unavailable');txt('st-detail','Could not read agent status from the agent.');return}

  const enabled=d.enabled!==false;
  const bs=d.last_backup_status||'';
  let kind='ok',head='Healthy',detail='';
  if(d.revoked){kind='err';head='Re-enrollment required';detail='The server rejected this device key. Ask your administrator to re-enroll.';}
  else if(!enabled){kind='warn';head='Disabled by server';detail='Backups and restores are stopped by the kill switch.';}
  else if(bs&&bs!=='success'){kind='err';head='Last backup failed';detail='Run "xentz-agent backup" in a terminal, then "xentz-agent status".';}
  else if(!d.last_backup){kind='warn';head='No backups yet';detail='Run "xentz-agent backup" in a terminal to start one now.';}
  else{head='Healthy';detail='Last backup '+relTime(d.last_backup);}
  badge('st-badge',kind,head);txt('st-detail',detail);

  badge('last-bk-time','',fmtTime(d.last_backup));
  txt('last-bk-detail',d.last_backup?relTime(d.last_backup)+' · '+bs+' · '+plural(d.last_backup_files||0,'file')+' scanned':'No backups recorded yet');
  badge('last-ret-time','',fmtTime(d.last_retention));
  txt('last-ret-detail',d.last_retention?relTime(d.last_retention)+' · '+d.last_retention_status:'No retention run recorded yet');

  if(d.revoked){badge('ks-badge','err','Revoked');txt('ks-detail','Device API key was rejected by the server.');}
  else if(!enabled){badge('ks-badge','warn','Disabled');txt('ks-detail','Server disabled this device (kill switch).');}
  else{badge('ks-badge','ok','Enabled');txt('ks-detail','Backups are running.');}

  const inc=Array.isArray(d.include)?d.include:[],exc=Array.isArray(d.exclude)?d.exclude:[];
  const list=document.getElementById('include-list');list.innerHTML='';
  if(inc.length===0){const s=document.createElement('span');s.className='hint';s.textContent='No include paths configured';list.appendChild(s);}
  else inc.forEach(p=>{const s=document.createElement('span');s.className='path-chip';s.textContent=p;list.appendChild(s)});
  let sched=d.daily_at?('Daily at '+d.daily_at):'No daily backup time configured';
  if(exc.length)sched+=' · '+plural(exc.length,'exclude pattern');
  if(d.retention_summary)sched+=' · retention: '+d.retention_summary;
  txt('sched-detail',sched);
  document.getElementById('config-summary-card').style.display='block';
}

async function makeDiag(){
  const el=document.getElementById('diag-toast');
  try{
    const r=await fetch(qs('/diagnostics'));
    if(!r.ok)throw new Error('request failed');
    const d=await r.json();
    // Use text nodes for the path: it is agent-generated, but a state dir
    // containing HTML characters must not be parsed as markup.
    el.textContent='Diagnostics bundle created: ';
    const code=document.createElement('code');
    code.textContent=d.path;
    el.appendChild(code);
  }catch(e){el.textContent='Could not create the diagnostics bundle. Try "xentz-agent diagnostics".'}
  el.style.display='block';
  setTimeout(()=>{el.style.display='none'},10000);
}

load();
</script>
</body>
</html>
